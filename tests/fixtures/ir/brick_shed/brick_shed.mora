{"id": "bh01", "op": "brick_texture", "params": {"size": 512, "rows": 8, "columns": 4, "map": "height"}},
{"id": "bn01", "op": "normal_map", "inputs": ["bh01"], "params": {"strength": 0.25}},
{"id": "mt02", "op": "material", "inputs": ["wl06", "bc01", "bn01"], "params": {"name": "brick", "slots": ["base_color", "normal"], "roughness": 0.85}}
],
"params": [
