{"id": "sl04", "op": "tag", "inputs": ["sl02"], "params": {"name": "slab_top", "select": {"normal_y": {"gt": 0.9}}}},
{"id": "sl03", "op": "unwrap", "inputs": ["sl04"], "params": {}},
