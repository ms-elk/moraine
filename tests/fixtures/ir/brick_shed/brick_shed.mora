{"id": "cn03", "op": "noise_texture", "params": {"seed": 12, "size": 256, "scale": 8, "octaves": 4, "low": 0.55, "high": 0.95}},
{"id": "mt01", "op": "material", "inputs": ["sl03", "cn02", "cn03"], "params": {"name": "concrete", "slots": ["base_color", "roughness"]}},
{"id": "wl01", "op": "box", "params": {"size": [2.0, 1.2, 1.4]}},
{"id": "wl02", "op": "box", "params": {"size": [1.76, 1.2, 1.16]}},
{"id": "wl03", "op": "transform", "inputs": ["wl02"], "params": {"translate": [0.0, 0.12, 0.0]}},
{"id": "wl04", "op": "boolean", "inputs": ["wl01", "wl03"], "params": {"mode": "difference"}},
{"id": "pl01", "op": "place", "inputs": ["sl04", "wl04"], "params": {"anchor": "slab_top"}},
{"id": "sn01", "op": "smooth_normals", "inputs": ["pl01"], "params": {}},
{"id": "wl06", "op": "unwrap", "inputs": ["sn01"], "params": {}},
